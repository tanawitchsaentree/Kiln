{
  "name": "kiln-ds-react",
  "version": "0.0.0",
  "private": false,
  "type": "module",
  "description": "Components for kiln-ds. One install and one import: import 'kiln-ds-react/all.css'.",
  "main": "./dist/index.cjs",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./all.css": {
      "types": "./styles.css.d.ts",
      "default": "./dist/all.css"
    },
    "./styles.css": {
      "types": "./styles.css.d.ts",
      "default": "./dist/styles.css"
    },
    "./tokens.css": {
      "types": "./styles.css.d.ts",
      "default": "./dist/tokens/tokens.css"
    },
    "./tokens": {
      "types": "./dist/tokens/tokens.d.ts",
      "default": "./dist/tokens/tokens.mjs"
    },
    "./tokens.json": "./dist/tokens/tokens.json",
    "./package.json": "./package.json"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json && node ../../tooling/bundle-tokens.mjs && node ../../tooling/knowledge.mjs",
    "typecheck": "tsc --noEmit -p .",
    "barrel:check": "node ../../tooling/generate-barrel.mjs --check",
    "prepack": "pnpm run build"
  },
  "dependencies": {},
  "module": "./dist/index.js",
  "types": "./dist/types/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "styles.css.d.ts",
    "bin"
  ],
  "sideEffects": [
    "*.css"
  ],
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "typescript": "^5.6.0",
    "vite": "^7.0.0",
    "kiln-ds-tokens": "workspace:^"
  },
  "bin": {
    "kiln-ds-mcp": "./bin/mcp.mjs"
  }
}
